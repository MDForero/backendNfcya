# --- App ---
NODE_ENV=development
PORT=3001
# URL pública del frontend (CORS, enlaces de correo y redirecciones de Google)
FRONTEND_URL=http://localhost:3000

# --- Base de datos ---
# PostgreSQL local (servicio postgresql-x64-18) o el de docker-compose (puerto 5433)
DATABASE_URL=postgres://nfcya:nfcya@localhost:5432/nfcya
# Base usada por pnpm test:e2e (se lee de .env.test si existe)
# DATABASE_URL=postgres://nfcya:nfcya@localhost:5432/nfcya_test
DATABASE_LOGGING=false

# --- Tokens ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Cookie de refresh ---
COOKIE_SECURE=false
# lax | strict | none (none exige COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Vacío = dominio del API. Ej: .nfcya.com para compartirla entre app. y api.
COOKIE_DOMAIN=

# --- Google OAuth (opcional: sin estas variables el login con Google queda deshabilitado) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- Correo ---
# log = escribe los correos en el log (desarrollo) | smtp = envía por SMTP
MAIL_TRANSPORT=log
MAIL_FROM="nfcYA <no-reply@nfcya.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Límites ---
AUTH_THROTTLE_LIMIT=20
AUTH_THROTTLE_TTL_SECONDS=60

# --- Bootstrap del primer SUPER_ADMIN (solo para pnpm seed:admin; retíralas después) ---
